rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Couple Profile (Main shared profile)
    match /couple_profile/{profileId} {
      allow read: if true;
      allow write: if true;
    }

    // Love Requests (Coupons & romantic asks)
    match /love_requests/{requestId} {
      allow read: if true;
      allow create, update: if isValidString(request.resource.data.title, 1, 300);
      allow delete: if true;
    }

    // Scrapbook Memories
    match /memories/{memoryId} {
      allow read: if true;
      allow create, update: if isValidString(request.resource.data.title, 1, 300);
      allow delete: if true;
    }

    // Sealed Love Letters
    match /letters/{letterId} {
      allow read: if true;
      allow create, update: if isValidString(request.resource.data.title, 1, 300);
      allow delete: if true;
    }

    // Voice Cassette Tracks
    match /voice_tracks/{trackId} {
      allow read: if true;
      allow create, update: if isValidString(request.resource.data.title, 1, 300);
      allow delete: if true;
    }

    // Bucket List items
    match /bucket_list/{itemId} {
      allow read: if true;
      allow create, update: if isValidString(request.resource.data.title, 1, 300);
      allow delete: if true;
    }

    // Couples Messenger / Sweet Whispers Chat
    match /love_messages/{messageId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
